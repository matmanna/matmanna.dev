#!/usr/bin/env bash
# Sends this machine's location to location.matmanna.dev.
# Uses GeoClue when available, otherwise the worker geolocates the request IP.
set -euo pipefail

ENDPOINT="${LOCATION_ENDPOINT:-https://location.matmanna.dev/update}"
TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/matmanna-location/token"
WHERE_AM_I=/usr/lib/geoclue-2.0/demos/where-am-i

token=$(<"$TOKEN_FILE")
body='{}'

if [[ -x $WHERE_AM_I ]]; then
  # GeoClue's first fix is a coarse GeoIP guess (often the ISP's registered city, not ours).
  # The Wi-Fi based fix can take a minute, so wait for the first fix that is not GeoIP.
  out=$(mktemp)
  trap 'rm -f "$out"' EXIT
  "$WHERE_AM_I" -t 90 >"$out" 2>/dev/null &
  pid=$!
  lat= lng=
  for _ in $(seq 90); do
    read -r lat lng < <(awk '
      /^Latitude:/  { sub("°", "", $2); la = $2 }
      /^Longitude:/ { sub("°", "", $2); lo = $2 }
      /^Description:/ && $0 !~ /GeoIP/ { l = la " " lo }
      END { print l }' "$out") || true
    [[ -n $lat && -n $lng ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  if [[ -n $lat && -n $lng ]]; then
    body="{\"lat\":$lat,\"lng\":$lng}"
  fi
fi

curl -fsS -X POST "$ENDPOINT" \
  -H "Authorization: Bearer $token" \
  -H "Content-Type: application/json" \
  --data "$body"
echo
